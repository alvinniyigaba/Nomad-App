{
  "crons": [
    {
      "path": "/api/admin?resource=sync-sheet",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/admin?resource=sync-investments",
      "schedule": "10 6 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/(.*)",
      "destination": "/admin.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
